{
  "appId": "io.sketchdraw.de",
  "productName": "Sketchdraw",
  "copyright": "Copyright \u00a9 J-ARTS",
  "asar": true,
  "publish": null,
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "dist-mcp/**/*",
    "package.json"
  ],
  "extraMetadata": {
    "main": "dist-electron/main.cjs",
    "homepage": "https://github.com/J-ARTS/de.sketchdraw.io"
  },
  "mac": {
    "category": "public.app-category.developer-tools",
    "darkModeSupport": true,
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "artifactName": "${productName}-${version}-macos-${arch}.${ext}",
    "target": [
      {
        "target": "dmg",
        "arch": [
          "arm64"
        ]
      }
    ]
  },
  "dmg": {
    "artifactName": "${productName}-${version}-macos-${arch}.${ext}",
    "sign": false,
    "writeUpdateInfo": false
  },
  "win": {
    "artifactName": "${productName}-${version}-windows-${arch}.${ext}",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "artifactName": "${productName}-${version}-windows-${arch}.${ext}",
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "differentialPackage": false
  },
  "linux": {
    "category": "Development",
    "maintainer": "J-ARTS",
    "synopsis": "Visual Workspace for Architecture, Diagrams, and P2P Collaboration",
    "artifactName": "${productName}-${version}-linux-x64.${ext}",
    "target": [
      {
        "target": "deb",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "deb": {
    "artifactName": "${productName}-${version}-linux-x64.${ext}",
    "priority": "optional"
  }
}
