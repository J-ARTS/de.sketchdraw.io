{
  "extends": "./electron-builder.json",
  "appx": {
    "identityName": "${env.STORE_IDENTITY_NAME}",
    "publisher": "${env.STORE_PUBLISHER}",
    "publisherDisplayName": "${env.STORE_PUBLISHER_DISPLAY_NAME}",
    "displayName": "Sketchdraw",
    "applicationId": "Sketchdraw",
    "backgroundColor": "transparent",
    "languages": [
      "de-DE",
      "en-US"
    ],
    "capabilities": [
      "runFullTrust"
    ],
    "artifactName": "${productName}-${version}-store-${arch}.${ext}"
  }
}
